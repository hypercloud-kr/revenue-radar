# Revenue Radar — 환경변수 예시. 로컬은 이 파일을 `.env`로 복사해서 사용.
# 키는 백엔드 환경변수로만. 없으면 seed/mock + alio(무인증) 자동.

# DB
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar
POSTGRES_DB=radar

# CORS: 준비 중엔 * → published origin 확정 후 좁히기(§4-13)
CORS_ORIGIN=*

# AI (없으면 Generate는 mock으로 동작)
ANTHROPIC_API_KEY=
PROPOSAL_MODEL=claude-sonnet-4-6

# 공공데이터 (없어도 alio 무인증으로 수집 보장)
DATA_GO_KR_API_KEY=
KOCCA_API_KEY=

# 운영(Caddy https). 예: 13-125-1-2.nip.io
SITE_ADDRESS=
